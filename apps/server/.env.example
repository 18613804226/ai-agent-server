# ===========================================================================
# 复制为 .env 后按实际填写。这是 docker-compose.4001.yml 用的配置。
#
# ⚠️ 关键：DATABASE_URL 必须用 compose 服务名 postgres + 内部端口 5432，
#   不能写 localhost（那是容器自己，连不到 postgres）；
#   env_file 不做 ${} 插值，所以 DATABASE_URL 要写真值，不能写 ${DB_USER}。
# ===========================================================================

# ---- 数据库 ----
# DB_USER/PASSWORD/NAME：给 postgres 容器建库用（compose 里 POSTGRES_USER 等引用）
DB_USER=aiagent
DB_PASSWORD=change_me
DB_NAME=aiagent
# DATABASE_URL：给后端连库用。用户/密码/库名要和上面三个一致；主机=postgres，端口=5432
DATABASE_URL=postgresql://aiagent:change_me@postgres:5432/aiagent

# ---- 大模型 / 联网搜索 ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
# ModelScope 首选模型专用（独立端点 + 独立 Token）
# ⚠️ 不要把真实 Token 写进本文件并提交仓库；留空则该候选自动跳过并降级
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
# 智谱 GLM 免费层（留空则所有 glm-* 候选自动剔除，不进候选链）
GLM_API_KEY=
# ---- 联网搜索（provider 可切换）----
# tavily = 默认（境外）；bocha = 国内博查（https://open.bochaai.com）
WEB_SEARCH_PROVIDER=tavily
# Tavily 联网搜索（provider=tavily 时必填；留空则本轮检索失败并自动降级为无实时资料）
TAVILY_API_KEY=
# 博查（provider=bocha 时必填）
BOCHA_API_KEY=
# 可选：留空用官方 https://api.bochaai.com/v1/web-search
BOCHA_API_URL=
# 可选：单次联网超时，1000~60000，默认 15000
WEB_SEARCH_TIMEOUT_MS=15000

# ---- 可选 ----
PORT=3000
# 图片 URL 的对外前缀（例：https://api.example.com）。留空则用请求的 Host；
# 部署在 Nginx/HTTPS 后面时建议配成公网域名，否则落库的图片地址可能指向内网 http。
PUBLIC_BASE_URL=

# ---- 可选：模型级联覆盖 ----
# 这些值优先于 packages/agent-orchestrator/src/model-cascade.ts 的 DEFAULT_MODELS：
# 配了以本文件为准，没配的变量才走代码默认值。
#
# 平台按「模型名」推导（providerForModel），不是按档位推导：
#   glm* 开头         → zhipu     （GLM_API_KEY；缺 key 时该候选自动剔除）
#   Model-Id 带斜杠 / → modelscope（MODELSCOPE_API_KEY；缺 key 时该 modelscope 首选自动摘掉）
#   其余一律          → dashscope （OPENAI_API_KEY + OPENAI_BASE_URL）
#   ⚠️ 下面 3 个 deepseek-* 归 dashscope，需 OPENAI_BASE_URL 端点支持这些模型名；
#      不支持会 400 模型不存在，再由级联自动降级到下一个候选。
#
# CHAT_MODEL_PRIORITY 不参与评分、直接插到所有档位链首。
# 默认值 moonshotai/Kimi-K3.1-Pro:DashScope 是 ModelScope 的完整 Model-Id，
# 走 MODELSCOPE_BASE_URL + MODELSCOPE_API_KEY 独立端点。
# ⚠️ 不能写成裸名 Kimi-K3.1-Pro：不带斜杠会被判成 dashscope，发到主网关会 404 Model not exist.
# ⚠️ 不配 MODELSCOPE_API_KEY 时，这个首选会被自动摘掉，等于没启用。
# 它有次数限制，429 不做退避重试、立即降级；设 off/none/disabled 可恢复纯评分路由。
# 候选按顺序降级、同名去重，一旦开始吐字就不再换模型（避免重复输出）。
#
# 当前这套值的分级路径（全 key 齐备；MODELSCOPE_API_KEY 留空时从第二个候选开始）：
#   图片 vision  → Kimi → deepseek-v4.1-flash → qwen3.7-flash
#   文本 simple  → Kimi → glm-4.5-flash → qwen3.7-flash
#   文本 complex → Kimi → glm-4.5-flash → deepseek-v4.1-flash → qwen3.8-max-0902 → qwen3.7-flash
#   文本 expert  → Kimi → glm-4.5-flash → deepseek-v4-pro-0813 → qwen3.8-max-0902 → qwen3.7-flash
#   文本档纯规则打分：>=3 complex、>=5 expert（CHAT_COMPLEXITY_THRESHOLD /
#   CHAT_EXPERT_THRESHOLD 可调）；含图片一票走 vision，不看分数。
#
CHAT_MODEL_PRIORITY=moonshotai/Kimi-K3.1-Pro:DashScope
# Kimi K3 思考强度（顶层 reasoning_effort）：low / high / max，官方默认 max；
# 默认压到 low 换更快首字与更低 token，只对 kimi-k3 候选下发
CHAT_KIMI_REASONING_EFFORT=low
CHAT_MODEL_TEXT_COMPLEX=deepseek-v4.1-flash
CHAT_MODEL_COMPLEX_FALLBACK=qwen3.8-max-0902
CHAT_MODEL_FALLBACK=qwen3.7-flash
CHAT_MODEL_TEXT_SIMPLE=glm-4.5-flash
CHAT_MODEL_TEXT_EXPERT=deepseek-v4-pro-0813
CHAT_MODEL_VISION=deepseek-v4.1-flash

# ---- 智谱思考链 ----
# 默认开启（客户端靠它展示「思考 M + 正文 N」的 token 拆分）；
# 要快首字就配 false / off / 0；非推理模型（glm-4-flash 等）开了也不会产出思考。
CHAT_GLM_THINKING=true

# ---- 上下文与工具循环预算 ----
# CHAT_MAX_INPUT_TOKENS 是宿主侧「初始输入窗口」：从最新往前装历史消息，
# 扣掉 system prompt、本轮附件正文、图片（每张 1200）和 760 摘要预留后，剩下的才给历史。
# 纯短聊天默认 6000 够用；长多轮 / 附件 / 图片较多时建议 12000~16000
# （输入 token、费用与首字延迟会随之上涨）。可配范围 1000~100000。
CHAT_MAX_INPUT_TOKENS=6000
# 编排器工具循环预算：留空 = 上面 +18000；填值直接覆盖。
# 只想放宽历史、不想让工具循环预算跟着涨时，在这里钉死一个数。
CHAT_CONTEXT_MAX_INPUT_TOKENS=
