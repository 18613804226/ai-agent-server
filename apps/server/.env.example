# ===========================================================================
# 复制为 .env 后按实际填写。这是 docker-compose.4001.yml 用的配置。
#
# ⚠️ 关键：DATABASE_URL 必须用 compose 服务名 postgres + 内部端口 5432，
#   不能写 localhost（那是容器自己，连不到 postgres）；
#   env_file 不做 ${} 插值，所以 DATABASE_URL 要写真值，不能写 ${DB_USER}。
# ===========================================================================

# ---- 数据库 ----
# DB_USER/PASSWORD/NAME：给 postgres 容器建库用（compose 里 POSTGRES_USER 等引用）
DB_USER=aiagent
DB_PASSWORD=change_me
DB_NAME=aiagent
# DATABASE_URL：给后端连库用。用户/密码/库名要和上面三个一致；主机=postgres，端口=5432
DATABASE_URL=postgresql://aiagent:change_me@postgres:5432/aiagent

# ---- 大模型 / 联网搜索 ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
# ModelScope 首选模型专用（独立端点 + 独立 Token）
# ⚠️ 不要把真实 Token 写进本文件并提交仓库；留空则该候选自动跳过并降级
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
# 智谱 GLM 免费层（留空则所有 glm-* 候选自动剔除，不进候选链）
GLM_API_KEY=
# Tavily 联网搜索（留空则不联网搜索）
TAVILY_API_KEY=

# ---- 可选 ----
PORT=3000

# ---- 可选：模型级联覆盖 ----
# 这些值优先于 packages/agent-orchestrator/src/model-cascade.ts 的 DEFAULT_MODELS：
# 配了以本文件为准，没配的变量才走代码默认值。
#
# 平台按「模型名」推导（providerForModel），不是按档位推导：
#   glm* 开头         → zhipu     （GLM_API_KEY；缺 key 时该候选自动剔除）
#   Model-Id 带斜杠 / → modelscope（MODELSCOPE_API_KEY；缺 key 时首选自动摘掉）
#   其余一律          → dashscope （OPENAI_API_KEY + OPENAI_BASE_URL）
#   ⚠️ 下面 3 个 deepseek-* 归 dashscope，需 OPENAI_BASE_URL 端点支持这些模型名；
#      不支持会 400 模型不存在，再由级联自动降级到下一个候选。
#
# CHAT_MODEL_PRIORITY 不参与评分、直接插到所有档位链首（3.8 = Qwen/Qwen3.8-Flash-Next）；
# 它有次数限制，429 不做退避重试、立即降级；设 off/none/disabled 可恢复纯评分路由。
# 候选按顺序降级、同名去重，一旦开始吐字就不再换模型（避免重复输出）。
#
# 当前这套值的分级路径（全 key 齐备；MODELSCOPE_API_KEY 留空时从第二个候选开始）：
#   图片 vision  → 3.8 → deepseek-v4.1-flash → qwen3.7-flash
#   文本 simple  → 3.8 → glm-4.5-flash → qwen3.7-flash
#   文本 complex → 3.8 → glm-4.5-flash → deepseek-v4.1-flash → qwen3.8-max-0902 → qwen3.7-flash
#   文本 expert  → 3.8 → glm-4.5-flash → deepseek-v4-pro-0813 → qwen3.8-max-0902 → qwen3.7-flash
#   文本档纯规则打分：>=3 complex、>=5 expert（CHAT_COMPLEXITY_THRESHOLD /
#   CHAT_EXPERT_THRESHOLD 可调）；含图片一票走 vision，不看分数。
#
CHAT_MODEL_PRIORITY=Qwen/Qwen3.8-Flash-Next
CHAT_MODEL_TEXT_COMPLEX=deepseek-v4.1-flash
CHAT_MODEL_COMPLEX_FALLBACK=qwen3.8-max-0902
CHAT_MODEL_FALLBACK=qwen3.7-flash
CHAT_MODEL_TEXT_SIMPLE=glm-4.5-flash
CHAT_MODEL_TEXT_EXPERT=deepseek-v4-pro-0813
CHAT_MODEL_VISION=deepseek-v4.1-flash
