# ===========================================================================
# 复制为 .env 后按实际填写。这是 docker-compose.4001.yml 用的配置。
#
# ⚠️ 关键：DATABASE_URL 必须用 compose 服务名 postgres + 内部端口 5432，
#   不能写 localhost（那是容器自己，连不到 postgres）；
#   env_file 不做 ${} 插值，所以 DATABASE_URL 要写真值，不能写 ${DB_USER}。
# ===========================================================================

# ---- 数据库 ----
# DB_USER/PASSWORD/NAME：给 postgres 容器建库用（compose 里 POSTGRES_USER 等引用）
DB_USER=aiagent
DB_PASSWORD=change_me
DB_NAME=aiagent
# DATABASE_URL：给后端连库用。用户/密码/库名要和上面三个一致；主机=postgres，端口=5432
DATABASE_URL=postgresql://aiagent:change_me@postgres:5432/aiagent

# ---- 大模型 / 联网搜索 ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 智谱 GLM 免费层（留空则全部走 qwen，不开启级联）
GLM_API_KEY=
# Tavily 联网搜索（留空则不联网搜索）
TAVILY_API_KEY=

# ---- 可选 ----
PORT=3000

# ---- 可选：模型级联覆盖 ----
# 下面这些值与 packages/agent-orchestrator/src/model-cascade.ts 的 DEFAULT_MODELS
# 保持一致；不配这些变量时走代码默认值，配了则以 env 为准（覆盖代码默认）。
CHAT_MODEL_VISION=qwen3.7-flash            # 含图片时首选
CHAT_MODEL_TEXT_SIMPLE=glm-4.5-flash       # 纯文本-简单 首选（免费）
CHAT_MODEL_TEXT_COMPLEX=qwen3.7-flash      # 纯文本-复杂 首选
CHAT_MODEL_TEXT_EXPERT=qwen3.8-max-0902    # 纯文本-高难度 首选（顶级模型）
CHAT_MODEL_COMPLEX_FALLBACK=qwen3.7-flash  # 复杂档兜底，可改 qwen3.7-plus
CHAT_MODEL_FALLBACK=qwen3.7-flash          # 全局兜底
